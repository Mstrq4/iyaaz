{
  "name": "iyaaz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:logic": "node --experimental-strip-types --test tests/ts/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:data": "python3 scripts/validate_snapshot.py",
    "test:rtl": "bash skills/rtl-css/scripts/audit_rtl.sh",
    "test": "npm run test:logic && npm run test:python && npm run test:data && npm run test:rtl",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "type": "module"
}
